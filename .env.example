# =============================================================================
# Savera Homestay — environment variables (copy to .env.local for local dev;
# set the same names in Vercel → Project → Settings → Environment Variables).
# Quote any value that contains # or spaces.
# =============================================================================

# --- Database (required) -----------------------------------------------------
# Supabase → Project Settings → Database → Connection string → "Transaction pooler"
# (port 6543). Use the pooler URL on Vercel; it is safe for serverless.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# --- Staff sign-in (required) ------------------------------------------------
# Long random secret that signs staff and guest session cookies (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everybody out.
SESSION_SECRET=""

# First administrator, created automatically on the first sign-in attempt when no staff
# account exists. They must choose a new password at first sign-in; after that these two
# values are no longer used (you can remove them).
DEFAULT_ADMIN_EMAIL="owner@example.com"
DEFAULT_ADMIN_PASSWORD="change-me-at-first-sign-in"

# --- File storage (recommended) ----------------------------------------------
# Room photos (public bucket 'room-photos') and guest ID documents (private bucket
# 'guest-documents') go to Supabase Storage. The service-role key is SERVER-ONLY:
# never prefix it with NEXT_PUBLIC_. Without these, files are kept in the database.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# --- Optional ----------------------------------------------------------------
# Hours a website booking request holds its rooms while awaiting confirmation (default 24).
BOOKING_HOLD_HOURS=24

# Homestay contact details shown on the website
NEXT_PUBLIC_HOMESTAY_NAME="Savera Homestay"
NEXT_PUBLIC_WHATSAPP_NUMBER=918101298882
NEXT_PUBLIC_PHONE_NUMBER="+91 81012 98882"
NEXT_PUBLIC_EMAIL=info.saverahomestay@gmail.com
NEXT_PUBLIC_LOCATION="35a, Hill Cart Rd, West Point, Cart Road, Darjeeling, West Bengal 734101"

# No longer used (remove from Vercel): ADMIN_ACCESS_CODE, ADMIN_SESSION_SECRET,
# NEXT_PUBLIC_SUPABASE_ANON_KEY (the browser never talks to the database directly).
