{
  "id": "/expenses",
  "name": "Savera Expense Logger",
  "short_name": "Expenses",
  "description": "Log signed Savera Homestay expenses in three taps, even with no signal. For Savera managers.",
  "start_url": "/expenses?source=pwa",
  "scope": "/expenses",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#142820",
  "theme_color": "#142820",
  "orientation": "portrait",
  "lang": "en-IN",
  "icons": [
    {
      "src": "/icons/expenses-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/expenses-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/expenses-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Log an expense",
      "short_name": "Log",
      "url": "/expenses?source=shortcut",
      "icons": [
        {
          "src": "/icons/expenses-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://saverahomestay.in/expenses.webmanifest"
    }
  ],
  "categories": [
    "business",
    "finance",
    "productivity"
  ],
  "screenshots": [
    {
      "src": "/screens/expenses-log.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Log an expense in three taps"
    },
    {
      "src": "/screens/expenses-today.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Today's entries, sent even after being offline"
    },
    {
      "src": "/screens/expenses-cash.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Your cash in hand"
    }
  ]
}