{
  "id": "/expenses",
  "name": "Savera Expense Logger",
  "short_name": "Expenses",
  "description": "Log signed Savera Homestay expenses in seconds, even offline (staff only).",
  "start_url": "/expenses?source=pwa",
  "scope": "/expenses",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#142820",
  "theme_color": "#142820",
  "orientation": "portrait",
  "lang": "en-IN",
  "icons": [
    { "src": "/icons/icon-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Log an expense", "short_name": "Log", "url": "/expenses?source=shortcut", "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }] }
  ],
  "related_applications": [{ "platform": "webapp", "url": "https://saverahomestay.in/expenses.webmanifest" }],
  "categories": ["business", "finance", "productivity"]
}
